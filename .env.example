# Copy to .env. Keep real credentials local; never commit this file after editing.
APP_PUBLIC_URL=http://localhost:8080
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
# local | upstream | nginx. Any non-local deployment requires HTTPS.
TLS_MODE=local
APP_TLS_PORT=8443
BOOTSTRAP_USERNAME=learner
BOOTSTRAP_PASSWORD=<REDACTED>

# Standard inference API, not a Coding Plan endpoint. Select one primary provider.
MODEL_PROVIDER=bailian
BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=<MODEL_ID>
BAILIAN_API_KEY=<REDACTED>
BAILIAN_INPUT_USD_PER_MILLION=<PRICE>
BAILIAN_OUTPUT_USD_PER_MILLION=<PRICE>
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=<MODEL_ID>
ZHIPU_API_KEY=<REDACTED>
ZHIPU_INPUT_USD_PER_MILLION=<PRICE>
ZHIPU_OUTPUT_USD_PER_MILLION=<PRICE>
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=<MODEL_OR_ENDPOINT_ID>
ARK_API_KEY=<REDACTED>
ARK_INPUT_USD_PER_MILLION=<PRICE>
ARK_OUTPUT_USD_PER_MILLION=<PRICE>
# Optional alternate provider: enable only after capability/quality validation.
MODEL_FALLBACK_PROVIDER=
MODEL_FALLBACK_VERIFIED=false
# USD budgets for each restricted service key; usage/cost depends on provider catalog.
APP_MODEL_MONTHLY_BUDGET=20
MEMORY_MODEL_MONTHLY_BUDGET=10
# Gateway timeout (minimum 630s); chat/planner client 600s, model activity 660s.
MODEL_REQUEST_TIMEOUT=630
DEPLOY_TIMEOUT=1800
APP_DEFAULT_TIMEZONE=Asia/Shanghai
APP_LOG_LEVEL=INFO

# Optional public learning-resource research. A chat must also opt in explicitly.
# DuckDuckGo does not require a paid API key; only the short search query is sent.
RESEARCH_ENABLED=false
RESEARCH_PROVIDER=duckduckgo
RESEARCH_TIMEOUT_SECONDS=12
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_CALLS=6
# Optional comma-separated domain allowlist, e.g. docs.python.org,pydantic.dev
RESEARCH_ALLOWED_DOMAINS=
RESEARCH_FETCH_MAX_BYTES=262144
RESEARCH_FETCH_MAX_CHARS=12000

# Optional self-hosted sandbox. Enable only after the node passes readiness checks.
# This endpoint is an unauthenticated trusted-network gRPC service; never expose it publicly.
SANDBOX_ENABLED=false
SANDBOX_ADDRESS=host.docker.internal:18443
SANDBOX_RPC_TIMEOUT_SECONDS=10
SANDBOX_EXECUTION_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_MB=256
SANDBOX_DEADLINE_SECONDS=240
SANDBOX_MAX_DAILY_EXECUTIONS=10
SANDBOX_MAX_CONCURRENT_PER_USER=2

# Official Coder: a private workspace lasts one explicit Agent task, then is destroyed.
# Requires the workspace-enabled self-hosted sandbox node in addition to SANDBOX_ENABLED.
CODING_ENABLED=false
CODING_DEADLINE_SECONDS=1800
CODING_MAX_DAILY_RUNS=5
CODING_MAX_CONCURRENT_PER_USER=1

# Voice providers and their API keys are configured in the administrator UI.
# An empty provider keeps voice unconfigured; saving configuration makes no provider call.
# configure.py preserves .secrets/voice_credentials_key; only API receives that file.
VOICE_ENABLED=true
VOICE_MAX_SESSION_SECONDS=300
VOICE_DAILY_SECONDS=900
VOICE_IDLE_SECONDS=60
VOICE_MAX_CONCURRENT=1
VOICE_LEASE_SECONDS=20
